---
const nav = [
	{ href: '/#how-it-renders', label: 'How it renders' },
	{ href: '/#screenshots', label: 'Screenshots' },
	{ href: '/#features', label: 'Features' },
	{ href: '/#pricing', label: 'Pricing' },
	{ href: '/docs/', label: 'Docs' },
];
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-slate-950/80 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href="/" class="flex items-center gap-2.5 text-slate-100">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" class="h-7 w-7 shrink-0" fill="none" aria-hidden="true">
				<circle cx="32" cy="32" r="14" fill="#38bdf8" />
				<path d="M32 18a14 14 0 0 1 12.1 7c2.7 4.7 1.8 8-1.9 9.5-3.7 1.6-9.6 1-16.4-1.6-6.8-2.7-11.9-6.5-13.9-10-2-3.5-.7-6.4 3.6-7.5A19 19 0 0 1 32 18Z" fill="#0ea5e9" opacity="0.55" />
				<ellipse cx="32" cy="32" rx="30" ry="9" stroke="#7dd3fc" stroke-width="2.4" fill="none" opacity="0.8" transform="rotate(-18 32 32)" />
			</svg>
			<span class="text-sm font-semibold tracking-wide">
				AeroPlanet <span class="text-sky-400">Volumetrics</span>
			</span>
		</a>

		<nav class="hidden items-center gap-7 text-sm text-slate-300 md:flex">
			{nav.map((item) => (
				<a href={item.href} class="transition hover:text-sky-300">{item.label}</a>
			))}
		</nav>

		<div class="flex items-center gap-3">
			<a
				href="https://discord.gg/CW4cqrszqD"
				target="_blank"
				rel="noopener noreferrer"
				class="hidden text-sm text-slate-400 transition hover:text-sky-300 sm:inline"
			>
				Discord
			</a>
			<a
				href="/#pricing"
				class="rounded-full bg-sky-500 px-4 py-2 text-sm font-semibold text-slate-950 shadow-[0_0_24px_-4px_rgba(56,189,248,0.7)] transition hover:bg-sky-400"
			>
				Get the plugin
			</a>
		</div>
	</div>
</header>
